# Environment template with SAFE PLACEHOLDERS. Copy to .env.local for docker compose (gitignored).
# Never put real secrets here; in AWS, secrets come from Secrets Manager via ECS task definitions.
ERP_ENVIRONMENT=local
ERP_AUTH_PROVIDER=dev                      # dev (local only) | entra
ERP_API_AUDIENCE=api://erp-local
ERP_MODEL_PROVIDER=fixture                 # fixture (local only) | bedrock
ERP_AWS_REGION=us-east-2
ERP_OPENSEARCH_URL=http://localhost:9200
ERP_OPENSEARCH_AUTH=none                   # none (local only) | sigv4
ERP_DYNAMODB_ENDPOINT=http://localhost:8001  # unset in AWS
ERP_TABLE_PREFIX=erp-local-
ERP_ARTIFACT_STORE=local                   # local | s3
ERP_SCANNER=dev_signature                  # dev_signature (local only) | clamav | guardduty
ERP_TRACING=noop                           # noop | langsmith
# Entra (required when ERP_AUTH_PROVIDER=entra)
ERP_ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
ERP_ENTRA_ALLOWED_TENANTS=["00000000-0000-0000-0000-000000000000"]
ERP_ENTRA_ACCEPTED_APP_ROLES=[]
ERP_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
ERP_GRAPH_CLIENT_SECRET_ARN=arn:aws:secretsmanager:us-east-2:000000000000:secret:placeholder
# LangSmith (optional; local dev works without it)
ERP_LANGSMITH_ENDPOINT=https://langsmith.example.internal
LANGSMITH_API_KEY=set-in-secrets-manager-not-here
# Opt-in live tests
RUN_LIVE_BEDROCK=0
RUN_CLOUD_TESTS=0
