        <mxCell id="qp-title1" value="&lt;b style='font-size:20px'&gt;Query path — deterministic RAG workflow with authorization at every hop&lt;/b&gt;&lt;br&gt;enterprise-rag-platform · dev env (us-east-2) · 2026-10-01 · each step is a checkpointed state; LLMs only fill typed slots" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;spacing=8;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a0" value="&lt;b&gt;① Verify Entra JWT&lt;/b&gt;&lt;br&gt;RS256 · iss / aud / tid&lt;br&gt;exp · nbf · scp → else 401" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="380" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;② Build AuthzContext&lt;/b&gt;&lt;br&gt;server-side only: tenant,&lt;br&gt;user + groups, clearance, projects" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="400" y="380" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;③ Validated answer cache&lt;/b&gt;&lt;br&gt;key = principal-set hash;&lt;br&gt;evidence re-authorized on read" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="380" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;④ Plan query&lt;/b&gt;&lt;br&gt;rewrite · acronyms · ≤N subqueries&lt;br&gt;suggested filters only narrow" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1040" y="380" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;⑤ Hybrid retrieval&lt;/b&gt;&lt;br&gt;BM25 top-50 ∥ kNN top-50&lt;br&gt;same mandatory ACL filter" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1360" y="380" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="&lt;b&gt;⑥ RRF fusion&lt;/b&gt; (k = 60)&lt;br&gt;dedupe by chunk id" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1680" y="380" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="&lt;b&gt;⑦ Authoritative recheck&lt;/b&gt;&lt;br&gt;batch decide() vs DynamoDB&lt;br&gt;revoked / stale → dropped" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="2000" y="380" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b0" value="&lt;b&gt;⑧ Rerank&lt;/b&gt;&lt;br&gt;≤40 candidates → top-k&lt;br&gt;LLM rerank (Nova)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="2000" y="760" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;⑨ Pack + sufficiency&lt;/b&gt;&lt;br&gt;≤10 passages · doc diversity&lt;br&gt;insufficient → retry once / abstain" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1680" y="760" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;⑩ Generate&lt;/b&gt;&lt;br&gt;evidence wrapped as untrusted data&lt;br&gt;structured claims + citation ids" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1360" y="760" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;⑪ Validate citations&lt;/b&gt;&lt;br&gt;ids ∈ packed evidence; page /&lt;br&gt;revision resolved server-side" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1040" y="760" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;⑫ Judge&lt;/b&gt; (rubric judge-v1)&lt;br&gt;pass · revise (≤1 repair) · abstain&lt;br&gt;cannot override hard failures" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="760" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="&lt;b&gt;⑬ Release or abstain&lt;/b&gt;&lt;br&gt;answered · limited · abstained&lt;br&gt;(high-assurance: buffered)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="400" y="760" width="230" height="100" as="geometry" />
        </mxCell>
