        <mxCell id="az-title1" value="&lt;b style='font-size:20px'&gt;Document-level authorization — deny by default, six gates + audit&lt;/b&gt;&lt;br&gt;enterprise-rag-platform · dev env (us-east-2) · 2026-10-01 · the client never supplies tenant, groups or filters" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;spacing=8;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="users" value="User (browser)" style="sketch=0;outlineConnect=0;html=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#232F3D;strokeColor=none;dashed=0;aspect=fixed;shape=mxgraph.aws4.users;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="idp" value="Entra ID (AWS / prod)&lt;br&gt;&lt;i&gt;dev IdP only when ERP_ENVIRONMENT=local&lt;/i&gt;" style="sketch=0;outlineConnect=0;html=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#232F3D;strokeColor=none;dashed=0;aspect=fixed;shape=mxgraph.aws4.saml_token;" vertex="1" parent="1">
          <mxGeometry x="300" y="330" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="tv" value="&lt;b&gt;TokenVerifier&lt;/b&gt;&lt;br&gt;RS256 only · JWKS rotation&lt;br&gt;rejects ID tokens, alg=none,&lt;br&gt;HS256 confusion, wrong tid" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="305" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ctx" value="&lt;b&gt;AuthzContext&lt;/b&gt;&lt;br&gt;tenant · user + group principals&lt;br&gt;(Graph on overage) · clearance&lt;br&gt;· projects" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="305" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="dec" value="&lt;b&gt;decide(ctx, DocPermissionRecord)&lt;/b&gt;&lt;br&gt;→ Allow | Deny(reason)&lt;br&gt;&lt;br&gt;Deny: tenant mismatch · no principal overlap · explicit deny · project restriction · label above clearance / unknown · ACL stale · tombstoned / revoked · not current version" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#DD344C;fontSize=11;fontColor=#232F3E;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1160" y="260" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="ep" value="Enforcement points — index prefilter, authoritative decide(), audit record" style="whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 8;container=1;dropTarget=1;collapsible=0;recursiveResize=0;strokeColor=#DD344C;fontColor=#DD344C;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1540" y="120" width="520" height="960" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="&lt;b&gt;E1 · Index prefilter&lt;/b&gt; — search_filter(ctx): tenant, principals, must_not denied, label ≤ clearance, published only; on BM25 &lt;i&gt;and&lt;/i&gt; kNN" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=left;spacing=6;" vertex="1" parent="ep">
          <mxGeometry x="30" y="50" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="&lt;b&gt;E2 · Authoritative recheck&lt;/b&gt; — batch decide() against DynamoDB before rerank, generation and judge" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=left;spacing=6;" vertex="1" parent="ep">
          <mxGeometry x="30" y="178" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="&lt;b&gt;E3 · Answer cache&lt;/b&gt; — keyed by principal-set hash; evidence re-checked with decide() on every read" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=left;spacing=6;" vertex="1" parent="ep">
          <mxGeometry x="30" y="306" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="&lt;b&gt;E4 · Conversation history&lt;/b&gt; — decide() per cited source; turns citing now-unauthorized evidence are redacted" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=left;spacing=6;" vertex="1" parent="ep">
          <mxGeometry x="30" y="434" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="&lt;b&gt;E5 · Citation open + download&lt;/b&gt; — /api/citations/{id} and /api/documents/{id}/download re-run decide()" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=left;spacing=6;" vertex="1" parent="ep">
          <mxGeometry x="30" y="562" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="&lt;b&gt;E6 · Neighbour chunks&lt;/b&gt; — search_filter(ctx) + same version/section of an already-rechecked document" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=left;spacing=6;" vertex="1" parent="ep">
          <mxGeometry x="30" y="690" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="&lt;b&gt;Audit (records, does not gate)&lt;/b&gt; — allow / deny with reason, citation opens, admin actions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=left;spacing=6;" vertex="1" parent="ep">
          <mxGeometry x="30" y="818" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="os" value="OpenSearch&lt;br&gt;chunk ACL fields" style="sketch=0;outlineConnect=0;html=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elasticsearch_service;" vertex="1" parent="1">
          <mxGeometry x="2200" y="181" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="ddb" value="DynamoDB&lt;br&gt;ACLs · revocations&lt;br&gt;manifests" style="sketch=0;outlineConnect=0;html=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="2200" y="440" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="cw" value="Audit log group&lt;br&gt;(KMS audit key)" style="sketch=0;outlineConnect=0;html=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="2200" y="940" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="doc" value="Source document&lt;br&gt;+ ACL (_access.yaml / SharePoint)" style="sketch=0;outlineConnect=0;html=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#232F3D;strokeColor=none;dashed=0;aspect=fixed;shape=mxgraph.aws4.documents;" vertex="1" parent="1">
          <mxGeometry x="60" y="1180" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="gov" value="&lt;b&gt;Governance labels&lt;/b&gt;&lt;br&gt;Purview adapter (blocked: no tenant)&lt;br&gt;dev: manual labels, tagged as such" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="330" y="1170" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pt" value="&lt;b&gt;policy_translation&lt;/b&gt;&lt;br&gt;source ACL + labels →&lt;br&gt;DocPermissionRecord&lt;br&gt;ambiguous / missing → deny" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="1160" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ddb2" value="DynamoDB&lt;br&gt;acl_version · governance_version" style="sketch=0;outlineConnect=0;html=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1030" y="1180" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="rv" value="&lt;b&gt;Revocation&lt;/b&gt; (admin / ACL change)&lt;br&gt;DynamoDB write → effective on the next&lt;br&gt;request; index cleanup runs async&lt;br&gt;&lt;i&gt;live: revoke → denied ≈ 2.7–3.3 s&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#DD344C;fontSize=11;fontColor=#232F3E;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1340" y="1160" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="az-note17" value="&lt;b&gt;Live on AWS (2026-10-01):&lt;/b&gt; 0 authorization violations across 22 questions × synthetic users in 2 tenants; owner group allowed, other group + other tenant denied on citation open; revoked doc blocked in answer, cache and history before index cleanup. HTTP 401 on missing / forged tokens via CloudFront. Citation decisions in this job call policy directly. &lt;i&gt;Entra token validation is implemented + tested against signed test tokens, not live-verified (no tenant).&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontColor=#232F3E;spacing=10;fillColor=#FFFFFF;strokeColor=#D5DBDB;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1700" y="1140" width="640" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
